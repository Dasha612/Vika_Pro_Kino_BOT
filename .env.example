# Шаблон конфигурации. Скопируй в .env и заполни пустые значения:
#   cp .env.example .env
# Файл .env в git не попадает (см. .gitignore).

# ─────────────── Telegram (обязательно) ───────────────
# Токен от @BotFather
TOKEN=

# ─────────────── PostgreSQL (обязательно) ───────────────
# Эти три переменные docker compose подставляет в сервис db при первом запуске.
POSTGRES_DB=kinobot_db
POSTGRES_USER=kinobot_admin
POSTGRES_PASSWORD=kinobot_password

# ВАЖНО: логин/пароль/имя базы здесь должны совпадать с POSTGRES_* выше,
# а хост — это имя сервиса из docker-compose.yml (db), а НЕ localhost.
# Для запуска скриптов с хост-машины (вне docker) поменяй db -> localhost.
DB_URL=postgresql+asyncpg://kinobot_admin:kinobot_password@db:5432/kinobot_db

# ─────────────── Redis (обязательно) ───────────────
# Внутри docker хост — имя сервиса redis. Снаружи — localhost.
REDIS_URL=redis://redis:6379/0

# ─────────────── TMDB (обязательно для наполнения базы) ───────────────
# Ключ API v3: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ─────────────── Необязательное ───────────────
# Проверка подписки на канал. Пусто = проверка выключена, бот доступен всем.
# CHAT_ID — числовой id канала без префикса -100 (префикс добавляется сам).
CHAT_ID=
CHANNEL_ID=
